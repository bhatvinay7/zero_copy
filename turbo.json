{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "cargo:check": {
      "cache": true,
      "inputs": ["**/*.rs", "**/Cargo.toml", "Cargo.lock"]
    },
    "cargo:build": {
      "cache": true,
      "inputs": ["**/*.rs", "**/Cargo.toml", "Cargo.lock"],
      "outputs": ["target/release/**"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}

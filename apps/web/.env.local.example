# Cloudflare R2 — required for the /api/r2/* upload routes
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=your-bucket-name

# Public CDN URL for your R2 bucket (Cloudflare R2 custom domain or r2.dev URL)
# e.g. https://pub-xxxx.r2.dev  OR  https://cdn.yourdomain.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# TUS server endpoint (Rust http-server that forwards to R2 via tusd)
# Leave empty if using the /api/r2/* direct multipart upload instead
NEXT_PUBLIC_TUS_ENDPOINT=http://localhost:1081/files/
